<Window x:Class="ToolCheckWin.Views.DisplayTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiểm tra Điểm chết &amp; Ám màn hình"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        Background="Red"
        Cursor="Hand"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Grid x:Name="RootGrid" Background="Red">
        <!-- Hướng dẫn nổi ở góc trên -->
        <Border x:Name="HintBanner"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Background="#AA0F172A"
                CornerRadius="8"
                Padding="16,10"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtColorStep"
                           Text="Màu 1/7: ĐỎ (RED) — Click chuột trái hoặc nhấn [SPACE] để đổi màu | [ESC] Kết thúc &amp; Chấm điểm"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Hộp thoại chọn kết quả trước khi đóng -->
        <Border x:Name="ResultModal"
                Visibility="Collapsed"
                Width="480"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="24">
            <StackPanel>
                <TextBlock Text="KẾT QUẢ KIỂM ĐỊNH MÀN HÌNH"
                           Foreground="#38BDF8"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Vui lòng chọn tình trạng tấm nền sau khi kiểm tra qua 7 dải màu:"
                           Foreground="#CBD5E1"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,18"/>

                <Button Click="BtnStatus0_Click"
                        Background="#16A34A"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Padding="14,12"
                        Margin="0,0,0,10"
                        BorderThickness="0"
                        Cursor="Hand"
                        Content="✔ ĐẠT CHUẨN — Không điểm chết, không ám ố (20/20 điểm)"/>

                <Button Click="BtnStatus1_Click"
                        Background="#D97706"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Padding="14,12"
                        Margin="0,0,0,10"
                        BorderThickness="0"
                        Cursor="Hand"
                        Content="⚠ LỖI NHẸ — Có 1-2 điểm chết nhỏ hoặc hở sáng nhẹ (12/20 điểm)"/>

                <Button Click="BtnStatus2_Click"
                        Background="#DC2626"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Padding="14,12"
                        BorderThickness="0"
                        Cursor="Hand"
                        Content="✖ KHÔNG ĐẠT — Sọc màn, đốm mực hoặc lỗi nặng (0/20 điểm)"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
