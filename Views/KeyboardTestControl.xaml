<UserControl x:Class="ToolCheckWin.Views.KeyboardTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Status -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="BẢNG MA TRẬN 84 PHÍM LAPTOP TIÊU CHUẨN (LOW-LEVEL HOOK)"
                           Foreground="#F8FAFC"
                           FontWeight="Bold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtKeyProgress"
                           Text="  (Đã test: 0/84 phím)"
                           Foreground="#38BDF8"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnResetKeys"
                        Click="BtnResetKeys_Click"
                        Content="Làm mới phím"
                        Background="#334155"
                        Foreground="White"
                        Padding="10,5"
                        Margin="0,0,8,0"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button x:Name="BtnPassKeyboard"
                        Click="BtnPassKeyboard_Click"
                        Content="✔ Pass Keyboard"
                        Background="#16A34A"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="12,5"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- 84-Key UniformGrid (6 rows x 14 columns = 84 keys) -->
        <Border Grid.Row="1"
                Background="#090D16"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <ItemsControl x:Name="KeyMatrixItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="14"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="2"
                                Height="34"
                                Background="{Binding BackgroundBrush}"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock Text="{Binding Label}"
                                       Foreground="{Binding ForegroundBrush}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Audio (NAudio Sine 440Hz Left/Right + Mic WaveInEvent) & Touchpad Bar -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="#090D16"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Speaker Left/Right Test -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LOA 440Hz:"
                               Foreground="#94A3B8"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button x:Name="BtnTestLeftSpeaker"
                            Click="BtnTestLeftSpeaker_Click"
                            Content="🔊 Loa Trái (Pan -1.0)"
                            Background="#0284C7"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="10,6"
                            Margin="0,0,6,0"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <Button x:Name="BtnTestRightSpeaker"
                            Click="BtnTestRightSpeaker_Click"
                            Content="🔊 Loa Phải (Pan +1.0)"
                            Background="#0284C7"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="10,6"
                            Margin="0,0,14,0"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>

                <!-- Microphone WaveInEvent ProgressBar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Button x:Name="BtnToggleMic"
                            Click="BtnToggleMic_Click"
                            Content="🎙 Bắt đầu thu Mic"
                            Background="#475569"
                            Foreground="White"
                            Padding="10,6"
                            Margin="0,0,8,0"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <ProgressBar x:Name="MicLevelBar"
                                 Width="150"
                                 Height="18"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="#22C55E"
                                 Background="#1E293B"
                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtMicPercent"
                               Text="0%"
                               Width="38"
                               Margin="6,0,0,0"
                               Foreground="#CBD5E1"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Confirm Peripheral Pass Checkboxes / Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkTouchpadPassed"
                              IsChecked="True"
                              Checked="PeripheralCheck_Changed"
                              Unchecked="PeripheralCheck_Changed"
                              Content="Touchpad OK (+4đ)"
                              Foreground="#E2E8F0"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                    <CheckBox x:Name="ChkAudioCamPassed"
                              IsChecked="True"
                              Checked="PeripheralCheck_Changed"
                              Unchecked="PeripheralCheck_Changed"
                              Content="Loa/Mic/Cam OK (+6đ)"
                              Foreground="#E2E8F0"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
